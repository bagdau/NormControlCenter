# Local application port
PORT=3000
APP_PORT=3000
DOMAIN=
NODE_ENV=development

# Database connection for local PostgreSQL / Docker Compose
# Example: postgresql://normo:normo_dev_pass@localhost:5432/normocontrol
DATABASE_URL=

# Session signing secret (set a strong random string in real environments)
SESSION_SECRET=
POSTGRES_PASSWORD=

# Local directory for private uploaded files (never served as public static assets)
UPLOAD_DIR=./storage/uploads

# Application URL
APP_URL=http://localhost:3000
